---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import operators from '../../data/operator-quote-pages.json';

export function getStaticPaths() {
  return operators.map((op) => ({
    params: { operator: op.slug },
    props: { op },
  }));
}

interface Op {
  slug: string;
  name: string;
  title: string;
  description: string;
  subject: string;
}
const { op } = Astro.props as { op: Op };
---

<BaseLayout title={op.title} description={op.description} canonicalPath={`/quote/${op.slug}`}>
  <div class="bg-gradient-to-b from-lake-900 to-lake-800 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
      <Breadcrumbs crumbs={[{ label: 'Charter Quote', href: '/quote' }, { label: op.name }]} />
      <h1 class="mt-4 font-display text-3xl sm:text-4xl font-bold">
        Request A Charter Quote Direct From {op.name}
      </h1>
      <p class="mt-3 max-w-3xl text-lake-100 text-lg leading-relaxed">
        A free service to our viewers from Charter Flight Network. Use the following
        charter quote request form for a no cost, no obligation charter quote.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-10 sm:py-14">
    <div class="rounded-2xl bg-white p-6 sm:p-10 ring-1 ring-birch-200 shadow-sm">
      <h2 class="font-display text-xl font-bold text-lake-900">
        Complete and submit your contact &amp; travel information
      </h2>
      <p class="mt-1 text-slate-600 text-sm">
        Your request will be forwarded for a no obligation quote.
      </p>
      <div class="mt-8">
        <QuoteForm subject={op.subject} />
      </div>
    </div>
    <p class="mt-8 text-sm text-slate-500">
      Prefer to compare? Our <a href="/quote" class="font-semibold text-lake-700 hover:underline">standard quote request</a>
      reaches up to 3 operators best positioned for your route.
    </p>
  </div>
</BaseLayout>
