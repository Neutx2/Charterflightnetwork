---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../lib/site';

const title = 'Charter Quote Request — Up to 3 Competitive Quotes | Charter Flight Network';
const description =
  'Receive up to 3 competitive quotes when you complete and submit this no cost charter quote request. Jet, turboprop, float plane and helicopter charters across Canada, USA, Bahamas and Caribbean.';

// Every answer restates content that already appears on the site.
const faqs = [
  {
    q: 'How much does it cost to request quotes?',
    a: 'Nothing. The quote request service is free and there is never an obligation to accept any quote.',
  },
  {
    q: 'How many quotes will I receive?',
    a: 'Your request is forwarded to up to 3 charter airlines best positioned and equipped to provide the service requested. Each prepares a competitive quote and sends it directly to your email.',
  },
  {
    q: 'Is my contact information shared with the airlines?',
    a: 'No. We don’t share your name or contact info with airlines. Your request is assigned a unique ID; airlines submit quotes for that ID and we forward them to you.',
  },
  {
    q: 'How do I book once I have quotes?',
    a: 'You deal directly with the charter company of your choice to confirm all details, including scheduling, passenger names and payment. Payments are made directly to the charter company.',
  },
  {
    q: 'Is Charter Flight Network an airline?',
    a: 'No. Charter Flight Network is not a charter service provider and does not own or operate any aircraft. All charter quotes are generated by our charter network partners.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <PageHero width="narrow" center>
    <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold">
      Request Free Charter Quotes
    </h1>
    <p class="mt-4 text-lg text-lake-100 max-w-2xl mx-auto leading-relaxed">
      Charter Flight Network forwards your free quote request to the charter
      airlines best positioned and equipped for your trip. You receive up to 3
      competitive quotes by email and book directly with the operator.
    </p>
    <ul class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm font-semibold text-lake-100">
      <li>✓ Up to 3 competitive quotes</li>
      <li>✓ No cost, no obligation</li>
      <li>✓ Book direct with the operator</li>
    </ul>
  </PageHero>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-10 sm:py-14">
    <Breadcrumbs crumbs={[{ label: 'Charter Quote Request' }]} />

    <div class="mt-6 rounded-2xl bg-white p-6 sm:p-10 ring-1 ring-birch-200 shadow-sm">
      <QuoteForm subject="Charter Quote Request" />
    </div>

    <section class="mt-12 copy">
      <h2>How our quote service works</h2>
      <p>
        Charter Flight Network specializes in finding clients the most cost-efficient
        air charter options that match their needs. When you complete and submit the
        form above, we forward your inquiry to multiple charter airlines who are best
        positioned and equipped to provide the service you request. Each airline
        prepares and submits a competitive quote. If a quote meets your needs and
        budget, you deal directly with the airline of your choice to finalize all
        details, scheduling, and payment.
      </p>
      <p>
        <strong>Prefer the phone?</strong> Call us at&nbsp;<a href={SITE.phoneHref}>{SITE.phone}</a>
        and we'll take your trip details directly.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-semibold text-lake-900 mb-6">Frequently asked questions</h2>
      <dl class="space-y-6">
        {faqs.map((f) => (
          <div class="rounded-2xl bg-white p-6 ring-1 ring-birch-200">
            <dt class="font-display font-semibold text-lake-900">{f.q}</dt>
            <dd class="mt-2 text-slate-700 leading-relaxed">{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</BaseLayout>
