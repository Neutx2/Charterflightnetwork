---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const title = 'Quote Request Received | Charter Flight Network';
const description =
  'Your charter quote request has been forwarded to matching charter operators. Expect up to 3 competitive quotes by email.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 py-20 text-center">
    <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-boreal-100">
      <svg class="h-9 w-9 text-boreal-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
      </svg>
    </span>
    <h1 class="mt-6 font-display text-3xl sm:text-4xl font-bold text-lake-900" data-confirm-heading>
      Your request has been forwarded to matching charter operators.
    </h1>
    <script is:inline>
      // Alert signups share this page via ?from=alerts — swap the heading so
      // the message matches what was submitted. Static copy is the fallback.
      if (new URLSearchParams(location.search).get('from') === 'alerts') {
        var h = document.querySelector('[data-confirm-heading]');
        if (h) h.textContent = "You're signed up — we'll flag matching empty legs.";
        document.title = 'Signed Up | Charter Flight Network';
      }
    </script>
    <p class="mt-4 text-lg text-slate-600 leading-relaxed">
      Expect up to 3 competitive quotes delivered straight to your email. Each quote
      comes directly from the charter airline — review them, check out the company
      websites, and feel free to call any of the operators with questions.
    </p>
    <p class="mt-4 text-slate-600">
      Need to reach us in the meantime? Call
      <a href={SITE.phoneHref} class="font-semibold text-lake-700 hover:underline">{SITE.phone}</a>.
    </p>
    <div class="mt-8">
      <a href="/" class="rounded-lg bg-lake-800 px-6 py-3 font-semibold text-white hover:bg-lake-700 transition-colors">
        Back to home
      </a>
    </div>
  </div>
</BaseLayout>
