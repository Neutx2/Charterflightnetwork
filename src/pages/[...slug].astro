---
import { getCollection, render } from 'astro:content';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FacetOperators from '../components/FacetOperators.astro';
import { SITE } from '../lib/site';

// Migrated legacy pages that don't have a hand-built route:
// /travel/*, /flights/*, /operators/* subpages.
export async function getStaticPaths() {
  // pages with hand-built static routes (which take precedence)
  const handbuilt = new Set([
    'about',
    'contact',
    'privacy-policy',
    'quote',
    'quote-confirmation',
    'operators',
    'directory',
  ]);
  const entries = await getCollection('pages');
  return entries
    .filter((e) => !handbuilt.has(e.data.slug))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const isRoute = d.slug.startsWith('flights/');
const section = d.slug.startsWith('travel/')
  ? { label: 'Travel', href: undefined }
  : isRoute
    ? { label: 'Popular Routes', href: undefined }
    : { label: 'For Operators', href: '/operators' };
const pageLabel = d.h1 ?? d.title;

// Use-case pages get an operator module matched to their subject — the same
// structured data destination pages surface, filtered by service facet.
const FACET_MODULES: Record<
  string,
  { heading: string; description: string; facet: 'Floats' | 'Wheels' | 'Helicopter' | 'Skis'; provinces: string[] }
> = {
  'travel/fly-in-fishing': {
    heading: 'Float plane operators for fly-in trips',
    description:
      'Directory operators flying floats in Ontario and Manitoba — the heart of fly-in fishing country. Contact them directly, or let one free request reach the network.',
    facet: 'Floats',
    provinces: ['Ontario', 'Manitoba'],
  },
  'travel/canadian-arctic': {
    heading: 'Operators serving the North',
    description:
      'Directory operators based in the three territories. Contact them directly, or let one free request reach the operators equipped for Arctic flying.',
    facet: 'Wheels',
    provinces: ['Northwest Territories', 'Nunavut', 'Yukon'],
  },
  'travel/mining-exploration': {
    heading: 'Helicopter operators for exploration support',
    description:
      'Directory helicopter operators across the mining and exploration regions. Contact them directly, or let one free request reach the operators equipped for crew moves and slinging.',
    facet: 'Helicopter',
    provinces: ['British Columbia', 'Ontario', 'Quebec', 'Northwest Territories', 'Nunavut', 'Yukon'],
  },
  'travel/ontario-remote-communities': {
    heading: 'Wheel plane operators in Ontario',
    description:
      'Directory operators flying wheel planes across Ontario, including the remote northern communities. Contact them directly, or let one free request reach the network.',
    facet: 'Wheels',
    provinces: ['Ontario'],
  },
  'travel/churchill-polar-bears': {
    heading: 'Manitoba charter operators',
    description:
      'Directory operators based in Manitoba. Contact them directly, or let one free request reach the operators equipped for the Churchill run.',
    facet: 'Wheels',
    provinces: ['Manitoba'],
  },
};
const facetModule = FACET_MODULES[d.slug] ?? null;

// Route pages: link into the finder pre-filtered to the route's Canadian
// province (by its Canadian endpoint). Unmapped routes fall back to the
// unfiltered finder.
const ROUTE_PROVINCES: Record<string, string> = {
  'flights/campbell-river-from-calgary': 'British Columbia',
  'flights/kitchener-to-montreal-quebec': 'Ontario',
  'flights/kitchener-to-raleigh-durham': 'Ontario',
  'flights/minneapolis-to-red-lake-ontario': 'Ontario',
  'flights/toronto-chicago': 'Ontario',
  'flights/toronto-teterboro': 'Ontario',
  'flights/toronto-to-boston': 'Ontario',
  'flights/toronto-to-chicago': 'Ontario',
  'flights/toronto-to-montreal': 'Ontario',
  'flights/toronto-to-sault-ste-marie': 'Ontario',
  'flights/toronto-to-sudbury': 'Ontario',
  'flights/winnipeg-to-red-lake': 'Manitoba',
};
const routeProv = isRoute ? (ROUTE_PROVINCES[d.slug] ?? null) : null;
const routeFinderHref = routeProv
  ? `/directory/?prov=${encodeURIComponent(routeProv)}#find-an-operator`
  : '/directory/#find-an-operator';
---

<BaseLayout title={d.title} description={d.description} canonicalPath={`/${d.slug}`}>
  <PageHero>
    <Breadcrumbs crumbs={[section, { label: pageLabel }]} />
    <h1 class="mt-4 font-display text-3xl sm:text-4xl font-bold">{pageLabel}</h1>
    <p class="mt-3 max-w-3xl text-lake-100 text-lg leading-relaxed">{d.description}</p>
    {(isRoute || d.slug.startsWith('travel/')) && (
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={isRoute ? '#quote' : '/quote'} class="rounded-lg bg-ember-500 px-6 py-3 font-bold text-lake-950 hover:bg-ember-400 transition-colors">
          Get Free Quotes
        </a>
        <a href={SITE.phoneHref} class="rounded-lg border border-white/30 px-5 py-3 font-semibold hover:bg-white/10 transition-colors">
          {SITE.phone}
        </a>
      </div>
    )}
  </PageHero>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-10 sm:py-14">
    <article class="copy">
      <Content />
    </article>

    {facetModule && (
      <div class="not-prose">
        <FacetOperators {...facetModule} />
      </div>
    )}

    {isRoute ? (
      <section id="quote" class="mt-14 scroll-mt-24">
        <div class="rounded-2xl bg-white p-6 sm:p-10 ring-1 ring-birch-200 shadow-sm">
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-lake-900">
            Receive up to 3 competitive quotes for this route
          </h2>
          <div class="mt-8">
            <QuoteForm subject={d.quoteSubject ?? d.title} />
          </div>
        </div>
        <p class="mt-4 text-sm text-slate-600">
          Prefer to contact operators yourself? <a
            href={routeFinderHref} class="font-semibold text-lake-700 hover:underline">{`Search ${routeProv ? `${routeProv} operators` : 'the operator directory'} →`}</a>
        </p>
      </section>
    ) : (
      <div class="mt-14">
        <QuoteCTA />
      </div>
    )}
  </div>
</BaseLayout>
