---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';

const title = 'Canada Charter Flights by Province & Territory | Charter Flight Network';
const description =
  'Charter quotes for any province or territory. Private jet, turboprop, float plane and helicopter charter flights across Canada — receive up to 3 competitive quotes.';

const hubs = (await getCollection('hubs', (h) => h.data.region === 'canada')).sort(
  (a, b) => (a.data.province ?? '').localeCompare(b.data.province ?? '')
);
const destinations = await getCollection('destinations', (d) => d.data.region === 'canada');
const countFor = (slug?: string) => {
  // Newfoundland & Labrador share one destination set (as on the legacy site)
  const slugs =
    slug === 'labrador' || slug === 'newfoundland'
      ? ['labrador', 'newfoundland']
      : [slug];
  return destinations.filter((d) => slugs.includes(d.data.provinceSlug ?? '')).length;
};
---

<BaseLayout title={title} description={description} canonicalPath="/canada">
  <div class="bg-gradient-to-b from-lake-900 to-lake-800 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
      <Breadcrumbs crumbs={[{ label: 'Canada' }]} />
      <h1 class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-bold">
        Canada Charter Flights — Every Province &amp; Territory
      </h1>
      <p class="mt-3 max-w-3xl text-lake-100 text-lg leading-relaxed">
        Click any province or territory to view dozens of air charter destinations and
        connect with the charter airlines that provide service. Wheel plane, float
        plane and helicopter charters — receive up to 3 competitive quotes.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {hubs.map((hub) => (
        <li>
          <a
            href={`/canada/${hub.data.provinceSlug}`}
            class="group block rounded-2xl bg-white p-6 ring-1 ring-birch-200 shadow-sm hover:ring-lake-300 hover:shadow-md transition"
          >
            <h2 class="font-display text-xl font-semibold text-lake-900 group-hover:text-lake-700">
              {hub.data.province}
            </h2>
            <p class="mt-1.5 text-sm text-slate-600 line-clamp-2">{hub.data.description}</p>
            <p class="mt-3 text-sm font-semibold text-boreal-600">
              {countFor(hub.data.provinceSlug)} destinations →
            </p>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-14">
      <QuoteCTA />
    </div>
  </div>
</BaseLayout>
