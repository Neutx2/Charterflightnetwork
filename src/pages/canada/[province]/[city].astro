---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import QuoteCTA from '../../../components/QuoteCTA.astro';
import { SITE } from '../../../lib/site';

export async function getStaticPaths() {
  const destinations = await getCollection(
    'destinations',
    (d) => d.data.region === 'canada'
  );
  return destinations.map((entry) => ({
    params: { province: entry.data.provinceSlug, city: entry.data.slug.split('/').pop() },
    props: { entry, all: destinations },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const nearby = all
  .filter((e) => e.data.provinceSlug === d.provinceSlug && e.id !== entry.id)
  .sort((a, b) => (a.data.city ?? '').localeCompare(b.data.city ?? ''))
  .slice(0, 12);

const h1 = d.airportCode
  ? `${d.city} Charter Flights (${d.airportCode})`
  : `${d.city} Charter Flights`;

const canonicalPath = `/${d.slug}`;
const quoteSubject = d.quoteSubject ?? `Charter Flights ${d.city} ${d.province}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Air Charter Flights',
    name: h1,
    provider: { '@id': `${SITE.url}/#org` },
    areaServed: {
      '@type': 'City',
      name: d.city,
      containedInPlace: { '@type': 'AdministrativeArea', name: d.province },
    },
    description: d.description,
    offers: { '@type': 'Offer', priceCurrency: 'CAD', url: `${SITE.url}/quote` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Canada', item: `${SITE.url}/canada` },
      { '@type': 'ListItem', position: 3, name: d.province, item: `${SITE.url}/canada/${d.provinceSlug}` },
      { '@type': 'ListItem', position: 4, name: `${d.city} Charter Flights` },
    ],
  },
];
---

<BaseLayout title={d.title} description={d.description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <div class="bg-gradient-to-b from-lake-900 to-lake-800 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
      <Breadcrumbs
        crumbs={[
          { label: 'Canada', href: '/canada' },
          { label: d.province ?? 'Canada', href: `/canada/${d.provinceSlug}` },
          { label: d.city ?? h1 },
        ]}
      />
      <h1 class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-bold">{h1}</h1>
      <p class="mt-3 max-w-3xl text-lake-100 text-lg leading-relaxed">{d.description}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#quote" class="rounded-lg bg-ember-500 px-6 py-3 font-bold text-lake-950 hover:bg-ember-400 transition-colors">
          Get Free Quotes for {d.city}
        </a>
        <a href={SITE.phoneHref} class="rounded-lg border border-white/30 px-5 py-3 font-semibold hover:bg-white/10 transition-colors">
          {SITE.phone}
        </a>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-3">
      <article class="lg:col-span-2 copy">
        <Content />
      </article>

      <aside class="space-y-6">
        <div class="rounded-2xl bg-white p-6 ring-1 ring-birch-200 shadow-sm">
          <h2 class="font-display text-lg font-bold text-lake-900">
            Up to 3 competitive quotes
          </h2>
          <ul class="mt-3 space-y-2 text-sm text-slate-600">
            <li>✓ Free, no obligation</li>
            <li>✓ Matched to operators equipped for your trip</li>
            <li>✓ Book direct with the airline</li>
          </ul>
          <a href="#quote" class="mt-4 block rounded-lg bg-ember-500 px-4 py-2.5 text-center font-bold text-lake-950 hover:bg-ember-400 transition-colors">
            Request Quotes
          </a>
        </div>

        {nearby.length > 0 && (
          <div class="rounded-2xl bg-white p-6 ring-1 ring-birch-200 shadow-sm">
            <h2 class="font-display text-lg font-bold text-lake-900">
              Nearby {d.province} destinations
            </h2>
            <ul class="mt-3 grid gap-1.5 text-sm">
              {nearby.map((e) => (
                <li>
                  <a href={`/${e.data.slug}`} class="text-lake-600 hover:text-lake-800 hover:underline">
                    {e.data.city} charter flights
                  </a>
                </li>
              ))}
            </ul>
            <a href={`/canada/${d.provinceSlug}`} class="mt-3 inline-block text-sm font-semibold text-boreal-600 hover:text-boreal-700">
              All {d.province} destinations →
            </a>
          </div>
        )}
      </aside>
    </div>

    <section id="quote" class="mt-14 scroll-mt-24">
      <div class="rounded-2xl bg-white p-6 sm:p-10 ring-1 ring-birch-200 shadow-sm">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-lake-900">
          Receive up to 3 competitive quotes — {d.city}
        </h2>
        <p class="mt-2 text-slate-600 max-w-2xl">
          Complete your travel details. Choose any departure point in Canada or USA.
          Your request goes to the charter airlines best positioned and equipped for
          this route.
        </p>
        <div class="mt-8">
          <QuoteForm subject={quoteSubject} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
