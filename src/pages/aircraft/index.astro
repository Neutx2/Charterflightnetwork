---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';
import AircraftIcon from '../../components/AircraftIcon.astro';

const title = 'Charter Aircraft Types — Jets, Turboprops, Float Planes & Helicopters | Charter Flight Network';
const description =
  'Our service extends to all forms of charter aircraft: jet charters, turboprop and piston aircraft, float planes for wilderness access, and helicopters for specialized missions.';

const types = [
  {
    href: '/aircraft/jets',
    icon: 'jet' as const,
    name: 'Jets',
    blurb: 'Jet charters for corporate, private, and international travel.',
  },
  {
    href: '/aircraft/turboprops',
    icon: 'turboprop' as const,
    name: 'Turboprops & Piston Aircraft',
    blurb: 'Turboprop and piston aircraft charters for regional and remote destinations.',
    finder: { type: 'Wheels', label: 'Find wheel plane operators' },
  },
  {
    href: '/aircraft/float-planes',
    icon: 'float' as const,
    name: 'Float Planes',
    blurb: 'Float plane charters for access to wilderness lodges, northern communities, and fishing or hunting camps.',
    finder: { type: 'Floats', label: 'Find float plane operators' },
  },
  {
    href: '/aircraft/helicopters',
    icon: 'helicopter' as const,
    name: 'Helicopters',
    blurb: 'Helicopter charters for business, sightseeing, and specialized missions.',
    finder: { type: 'Helicopter', label: 'Find helicopter operators' },
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/aircraft">
  <PageHero>
    <Breadcrumbs crumbs={[{ label: 'Aircraft' }]} />
    <h1 class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-bold">
      Charter Aircraft Types
    </h1>
    <p class="mt-3 max-w-3xl text-lake-100 text-lg leading-relaxed">
      Charter Flight Network arranges every class of charter aircraft flown in
      Canada — jets, turboprops, piston aircraft, wheel planes, float planes
      and helicopters. Tell us where you're going — the operators best equipped
      for the trip will propose the right machine.
    </p>
  </PageHero>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
    <ul class="grid gap-6 sm:grid-cols-2">
      {types.map((t) => (
        <li class="rounded-2xl bg-white ring-1 ring-birch-200 shadow-sm hover:ring-lake-300 hover:shadow-md transition">
          <a href={t.href} class="group block p-8 pb-4">
            <AircraftIcon type={t.icon} class="h-10 w-20 text-lake-500 group-hover:text-lake-700 transition-colors" aria-hidden="true" />
            <h2 class="mt-3 font-display text-2xl font-semibold text-lake-900 group-hover:text-lake-700">{t.name}</h2>
            <p class="mt-2 text-slate-600 leading-relaxed">{t.blurb}</p>
            <span class="mt-4 inline-block font-semibold text-boreal-600">Learn more →</span>
          </a>
          {t.finder && (
            <div class="border-t border-birch-200 px-8 py-3">
              <a
                href={`/directory/?type=${t.finder.type}#find-an-operator`}
                class="text-sm font-semibold text-lake-700 hover:underline"
              >
                {t.finder.label} in the directory →
              </a>
            </div>
          )}
        </li>
      ))}
    </ul>
    <div class="mt-14">
      <QuoteCTA />
    </div>
  </div>
</BaseLayout>
