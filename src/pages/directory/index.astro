---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';
import { SITE } from '../../lib/site';

const title = 'Canadian Air Charter Directory | Wheel, Float Plane & Helicopter Charters';
const description =
  'Direct links to wheel plane, float plane, and helicopter charter services in every province and territory of Canada. Find the right charter operator fast.';

const entries = (await getCollection('directory')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<BaseLayout title={title} description={description} canonicalPath="/directory">
  <div class="bg-gradient-to-b from-lake-900 to-lake-800 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
      <Breadcrumbs crumbs={[{ label: 'Charter Directory' }]} />
      <h1 class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-bold">
        Canadian Air Charter Directory
      </h1>
      <p class="mt-3 max-w-3xl text-lake-100 text-lg leading-relaxed">
        Listing every wheel plane, float plane and helicopter charter airline in
        Canada. Contact any charter company directly and request a quote — or save
        time with our <a href="/quote" class="underline font-semibold">free quote request service</a>.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
    <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((e) => (
        <li>
          <a
            href={`/${e.data.slug}`}
            class="block rounded-lg bg-white px-4 py-3 text-sm font-medium text-lake-700 ring-1 ring-birch-200 hover:ring-lake-300 hover:text-lake-900 hover:shadow-sm transition"
          >
            {e.data.h1 ?? e.data.title}
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-slate-600">
      Also available at
      <a href={SITE.directoryUrl} class="font-semibold text-lake-700 hover:underline" target="_blank" rel="noopener noreferrer">
        canadianaircharterdirectory.com
      </a>.
    </p>
    <div class="mt-14">
      <QuoteCTA />
    </div>
  </div>
</BaseLayout>
