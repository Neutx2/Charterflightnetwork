---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';

export async function getStaticPaths() {
  const entries = await getCollection('directory');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug.replace(/^directory\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout title={d.title} description={d.description} canonicalPath={`/${d.slug}`}>
  <div class="bg-gradient-to-b from-lake-900 to-lake-800 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
      <Breadcrumbs crumbs={[{ label: 'Charter Directory', href: '/directory' }, { label: d.h1 ?? d.title }]} />
      <h1 class="mt-4 font-display text-3xl sm:text-4xl font-bold">{d.h1 ?? d.title}</h1>
      <p class="mt-3 max-w-3xl text-lake-100 text-lg leading-relaxed">{d.description}</p>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-10 sm:py-14">
    <article class="copy">
      <Content />
    </article>
    <div class="mt-14">
      <QuoteCTA
        heading="Skip the phone calls — get 3 quotes with one request"
        sub="Rather than contacting operators one by one, submit a single free quote request and receive up to 3 competitive quotes from the airlines best positioned for your trip."
      />
    </div>
  </div>
</BaseLayout>
