---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../lib/site';

const title = 'List Your Charter Service | Charter Flight Network';
const description =
  'Target your message to Canada’s largest air charter market. Open to every wheel plane, float plane and helicopter charter service in every province or territory of Canada.';
---

<BaseLayout title={title} description={description} canonicalPath="/operators">
  <div class="bg-gradient-to-b from-boreal-900 to-boreal-800 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
      <Breadcrumbs crumbs={[{ label: 'For Operators' }]} />
      <h1 class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-bold">
        Target Your Message To Canada's Largest Air Charter Market
      </h1>
      <p class="mt-3 max-w-3xl text-boreal-100 text-lg leading-relaxed">
        This program is open to every wheel plane, float plane and helicopter charter
        service in every province or territory of Canada.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-10 sm:py-14">
    <article class="copy">
      <h2>A free listing, and a way to grow it</h2>
      <p>
        We provide every wheel plane, float plane and helicopter charter service
        operating throughout every province and territory of Canada a basic free
        listing in our Canadian Air Charter Directory. Discover how to upgrade your
        basic free listing to a highly visible featured listing.
      </p>

      <h2>Pay only for qualified leads</h2>
      <p>
        We offer a very specialized charter lead generation program that only
        charges for high quality leads that meet your target market profile.
      </p>
      <p>
        When we receive a charter quote request, our database searches through our
        network of over 400 charter airlines across Canada and sends the request to
        up to 3 charter airlines who are best positioned and equipped to provide the
        service requested. Each participating airline prepares a competitive quote
        and sends it directly to the client.
      </p>
      <!-- TODO: confirm current lead-program pricing/terms with CFN; legacy site
           states the qualified-lead model but no rates, so operators are directed
           to contact CFN for details. -->

      <h2>Contact us for details on our Canadian Air Charter Marketing Program</h2>
      <p>
        Phone: <a href={SITE.phoneHref}>{SITE.phone}</a><br />
        Email: <a href="mailto:phil@charterflightnetwork.com">phil@charterflightnetwork.com</a>
      </p>
    </article>

    <div class="mt-12 rounded-2xl bg-white p-6 sm:p-8 ring-1 ring-birch-200 shadow-sm">
      <h2 class="font-display text-2xl font-bold text-lake-900">Apply to join the network</h2>
      <p class="mt-2 text-slate-600">
        Tell us about your operation and we'll follow up with program details.
      </p>
      <!--
        Operator application form. Posts to the same legacy formmailer.php endpoint
        used by the quote forms so submissions reach CFN by email.
        TODO(deploy): on Netlify, switch to Netlify Forms (see QuoteForm.astro notes).
      -->
      <form method="post" action="/formmailer.php" class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="absolute -left-[5000px] h-px w-px overflow-hidden" aria-hidden="true">
          <label for="op-website">Website</label>
          <input type="text" id="op-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="op-company">Company name</label>
          <input class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5" type="text" id="op-company" name="Company" required />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="op-name">Contact name</label>
          <input class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5" type="text" id="op-name" name="Name" required />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="op-email">Email</label>
          <input class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5" type="email" id="op-email" name="Email" required />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="op-phone">Phone</label>
          <input class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5" type="tel" id="op-phone" name="Phone" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="op-base">Base city / province</label>
          <input class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5" type="text" id="op-base" name="City" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="op-fleet">Fleet type</label>
          <input class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5" type="text" id="op-fleet" name="State" placeholder="Wheel plane / float plane / helicopter" />
        </div>
        <div class="sm:col-span-2">
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="op-info">Tell us about your operation</label>
          <textarea class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5" id="op-info" name="OtherInfo" rows="4"></textarea>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="rounded-lg bg-ember-500 px-8 py-3 font-bold text-lake-950 hover:bg-ember-400 transition-colors">
            Request Program Details
          </button>
        </div>
        <input type="hidden" name="recipient" value="phil@charterflightnetwork.com" />
        <input type="hidden" name="redirect" value="https://charterflightnetwork.com/quote-confirmation" />
        <input type="hidden" name="subject" value="Operator Listing Application" />
      </form>
    </div>
  </div>
</BaseLayout>
