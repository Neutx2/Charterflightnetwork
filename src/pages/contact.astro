---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../lib/site';

const title = 'Contact Charter Flight Network | Thunder Bay, Ontario';
const description =
  'Contact Charter Flight Network — 401 A Donald St West, Thunder Bay, Ontario. Phone (807) 472-1955. Request charter quotes or ask about our operator network.';
---

<BaseLayout title={title} description={description} canonicalPath="/contact">
  <div class="bg-gradient-to-b from-lake-900 to-lake-800 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
      <Breadcrumbs crumbs={[{ label: 'Contact' }]} />
      <h1 class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-bold">Contact Us</h1>
      <p class="mt-3 max-w-3xl text-lake-100 text-lg leading-relaxed">
        Questions about a quote request, or about listing your charter service?
        We're based in Thunder Bay, Ontario.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-10 sm:py-14 grid gap-10 md:grid-cols-2">
    <div>
      <div class="rounded-2xl bg-white p-6 sm:p-8 ring-1 ring-birch-200 shadow-sm">
        <h2 class="font-display text-xl font-bold text-lake-900">Charter Flight Network</h2>
        <address class="mt-4 not-italic leading-relaxed text-slate-700">
          {SITE.address.street}<br />
          {SITE.address.city}, {SITE.address.regionLong} {SITE.address.postalCode}
        </address>
        <div class="mt-5 space-y-3">
          <a href={SITE.phoneHref} class="flex items-center gap-3 rounded-lg bg-lake-800 px-5 py-3.5 font-bold text-white hover:bg-lake-700 transition-colors">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 006.6 6.6l2.2-2.2a1 1 0 011-.24c1.2.4 2.4.6 3.6.6a1 1 0 011 1V20a1 1 0 01-1 1C10.6 21 3 13.4 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.6 3.6a1 1 0 01-.25 1z"/></svg>
            Call {SITE.phone}
          </a>
          <a href="mailto:phil@charterflightnetwork.com" class="flex items-center gap-3 rounded-lg border border-lake-300 px-5 py-3.5 font-semibold text-lake-800 hover:bg-lake-50 transition-colors">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
            phil@charterflightnetwork.com
          </a>
        </div>
        <p class="mt-5 text-sm text-slate-600">
          Looking for a flight quote? Use our
          <a href="/quote" class="font-semibold text-lake-700 hover:underline">charter quote request form</a>
          — it reaches the operators best positioned for your trip.
        </p>
      </div>
    </div>

    <div class="rounded-2xl bg-white p-6 sm:p-8 ring-1 ring-birch-200 shadow-sm">
      <h2 class="font-display text-xl font-bold text-lake-900">Send us a message</h2>
      <!-- Posts to the legacy formmailer.php endpoint; TODO(deploy): Netlify Forms fallback -->
      <form method="post" action={SITE.formEndpoint} class="mt-5 grid gap-4">
        <div class="absolute -left-[5000px] h-px w-px overflow-hidden" aria-hidden="true">
          <label for="ct-website">Website</label>
          <input type="text" id="ct-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="ct-name">Name</label>
          <input class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5" type="text" id="ct-name" name="Name" autocomplete="name" required />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="ct-email">Email</label>
          <input class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5" type="email" id="ct-email" name="Email" autocomplete="email" required />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="ct-msg">Message</label>
          <textarea class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5" id="ct-msg" name="OtherInfo" rows="5" required></textarea>
        </div>
        <div>
          <button type="submit" class="rounded-lg bg-ember-500 px-8 py-3 font-bold text-lake-950 hover:bg-ember-400 transition-colors">
            Send Message
          </button>
        </div>
        <input type="hidden" name="recipient" value="phil@charterflightnetwork.com" />
        <input type="hidden" name="redirect" value="https://charterflightnetwork.com/quote-confirmation" />
        <input type="hidden" name="subject" value="Contact Form Message" />
      </form>
    </div>
  </div>
</BaseLayout>
