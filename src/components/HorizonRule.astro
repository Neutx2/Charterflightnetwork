---
/**
 * Brand divider: the logotype's tapered horizon (the same doubled-back cubic
 * lens, scaled down) with the aircraft climbing off its end — the identity's
 * motif reused as an ornament so section breaks carry the brand instead of a
 * plain rule. Decorative only (aria-hidden), sized in em so it scales with
 * context.
 */
interface Props {
  class?: string;
  /** teal on light backgrounds (default); 'light' for dark backgrounds */
  tone?: 'teal' | 'light';
  /** show the climbing aircraft at the right end */
  aircraft?: boolean;
}
const { class: cls = '', tone = 'teal', aircraft = true } = Astro.props;
const line = tone === 'light' ? '#7fb3c0' : '#2d7b8c';
const plane = '#ff7d02';
---

<div class={`flex justify-center ${cls}`} aria-hidden="true">
  <svg viewBox="0 -30 460 110" class="h-[2.2em] w-auto max-w-full" fill="none">
    <path d="M-16 72C90 8 370 8 476 72C370 20 90 20 -16 72Z" fill={line} />
    {aircraft && (
      <g transform="translate(368 14) rotate(38) scale(1.05) translate(-32 -32)" fill={plane}>
        <path d="M32 8c2.6 0 4.2 2.9 4.2 7.4v9.1l16.3 9.6c.9.5 1.5 1.5 1.5 2.6v4.1c0 .9-.9 1.6-1.8 1.3l-16-5.2v9.4l4.6 3.7c.5.4.8 1 .8 1.6v2.2c0 .8-.7 1.3-1.4 1.1L32 52.8l-8.2 1.1c-.7.2-1.4-.3-1.4-1.1v-2.2c0-.6.3-1.2.8-1.6l4.6-3.7v-9.4l-16 5.2c-.9.3-1.8-.4-1.8-1.3v-4.1c0-1.1.6-2.1 1.5-2.6l16.3-9.6v-9.1C27.8 10.9 29.4 8 32 8z" />
      </g>
    )}
  </svg>
</div>
