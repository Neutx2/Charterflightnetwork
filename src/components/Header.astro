---
import { SITE } from '../lib/site';
import Logo from './Logo.astro';

const nav = [
  { href: '/canada', label: 'Canada' },
  { href: '/usa', label: 'USA' },
  { href: '/bahamas', label: 'Bahamas' },
  { href: '/caribbean', label: 'Caribbean' },
  { href: '/aircraft', label: 'Aircraft' },
  { href: '/empty-legs', label: 'Empty Legs' },
  { href: '/operators', label: 'For Operators' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const { pathname } = Astro.url;
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(href + '/');
---

<header class="sticky top-0 z-50 bg-lake-950/95 backdrop-blur supports-[backdrop-filter]:bg-lake-950/90 text-white shadow-lg shadow-lake-950/20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="Charter Flight Network — home">
        <Logo size={36} class="shrink-0" />
        <span class="leading-tight">
          <span class="block font-display font-bold text-[15px] tracking-tight">Charter Flight Network</span>
          <span class="hidden sm:block text-[11px] text-lake-200">Canadian owned &amp; operated since {SITE.founded}</span>
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-1 text-sm" aria-label="Main">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-2.5 py-2 font-medium transition-colors hover:bg-white/10 hover:text-white',
              isActive(item.href) ? 'text-ember-400' : 'text-lake-100',
            ]}
          >{item.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a href={SITE.phoneHref} class="hidden md:flex items-center gap-1.5 text-sm font-semibold text-lake-100 hover:text-white px-2 py-2">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 006.6 6.6l2.2-2.2a1 1 0 011-.24c1.2.4 2.4.6 3.6.6a1 1 0 011 1V20a1 1 0 01-1 1C10.6 21 3 13.4 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.6 3.6a1 1 0 01-.25 1z"/></svg>
          {SITE.phone}
        </a>
        <a href="/quote" class="rounded-lg bg-ember-500 px-4 py-2 text-sm font-bold text-lake-950 shadow hover:bg-ember-400 transition-colors">
          Get Free Quotes
        </a>
        <button
          id="mobile-nav-toggle"
          type="button"
          class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-lake-100 hover:bg-white/10"
          aria-controls="mobile-nav"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path class="nav-open-icon" d="M4 7h16M4 12h16M4 17h16" />
            <path class="nav-close-icon hidden" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-nav" class="hidden lg:hidden border-t border-white/10 bg-lake-950">
    <nav class="mx-auto max-w-7xl px-4 py-3 flex flex-col gap-1 text-base" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-2.5 font-medium hover:bg-white/10',
            isActive(item.href) ? 'text-ember-400' : 'text-lake-100',
          ]}
        >{item.label}</a>
      ))}
      <a href={SITE.phoneHref} class="rounded-md px-3 py-2.5 font-semibold text-white flex items-center gap-2">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 006.6 6.6l2.2-2.2a1 1 0 011-.24c1.2.4 2.4.6 3.6.6a1 1 0 011 1V20a1 1 0 01-1 1C10.6 21 3 13.4 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.6 3.6a1 1 0 01-.25 1z"/></svg>
        Call {SITE.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.nav-open-icon')?.classList.toggle('hidden', open);
    toggle.querySelector('.nav-close-icon')?.classList.toggle('hidden', !open);
  });
</script>
