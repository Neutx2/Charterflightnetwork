---
/**
 * Searchable operator finder for the directory index — the 530-operator
 * dataset as a product instead of flat lists.
 *
 * Progressive enhancement, strictly additive: the whole section is hidden
 * until its script runs, so no-JS visitors see exactly the province lists
 * they see today and are promised nothing that doesn't work. The dataset
 * (~180 KB) is NOT shipped with the page — it's fetched from the static
 * /data/operator-finder.json endpoint on the first interaction (or when the
 * section scrolls into view), keeping the directory page itself light.
 *
 * Phone links need no wiring here: BaseLayout's delegated click listener
 * fires the GA4 contact_phone event for any tel: link, including ones this
 * component renders after load.
 */
import { DIRECTORY_GROUPS } from '../lib/directory-provinces';

const provinces = DIRECTORY_GROUPS.map(([label]) => label);
const services = ['Floats', 'Wheels', 'Helicopter', 'Skis'];
---

<section class="operator-finder hidden mb-12 rounded-2xl bg-white p-5 sm:p-7 ring-1 ring-birch-200 shadow-sm" aria-label="Operator finder">
  <h2 class="font-display text-xl font-bold text-lake-900">Find an operator</h2>
  <p class="mt-1 text-sm text-slate-600">
    Search every listed operator by name or base, or filter by province and aircraft type.
  </p>

  <div class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto]">
    <input
      type="search"
      class="finder-q w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-slate-900 placeholder-slate-400 focus:border-lake-500 focus:outline-none focus:ring-2 focus:ring-lake-500/30"
      placeholder="Operator name or base — e.g. “Kenora” or “air”"
      aria-label="Search operators by name or base"
    />
    <select
      class="finder-prov rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-slate-900 focus:border-lake-500 focus:outline-none focus:ring-2 focus:ring-lake-500/30"
      aria-label="Filter by province or region"
    >
      <option value="">All provinces &amp; regions</option>
      {provinces.map((p) => <option value={p}>{p}</option>)}
    </select>
  </div>

  <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter by aircraft type">
    {services.map((s) => (
      <button
        type="button"
        data-service={s}
        class="finder-chip rounded-full border border-slate-300 px-3.5 py-1.5 text-sm font-semibold text-slate-700 hover:border-lake-400 transition-colors"
        aria-pressed="false"
      >
        {s}
      </button>
    ))}
  </div>

  <p class="finder-count mt-4 text-sm font-semibold text-slate-700" role="status" aria-live="polite"></p>
  <ul class="finder-results mt-3 grid gap-2 sm:grid-cols-2"></ul>
  <div class="mt-4 text-center">
    <button
      type="button"
      class="finder-more hidden rounded-lg border border-slate-300 px-6 py-2.5 text-sm font-semibold text-slate-700 hover:bg-birch-100 transition-colors"
    >
      Show more
    </button>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.operator-finder');
  if (root) {
    const q = root.querySelector<HTMLInputElement>('.finder-q')!;
    const prov = root.querySelector<HTMLSelectElement>('.finder-prov')!;
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.finder-chip'));
    const list = root.querySelector<HTMLElement>('.finder-results')!;
    const count = root.querySelector<HTMLElement>('.finder-count')!;
    const more = root.querySelector<HTMLButtonElement>('.finder-more')!;

    type Row = {
      n: string; b: string | null; s: string | null; sf: string[]; a: string | null;
      p: string | null; t: string | null; d: string; prov: string; f: boolean;
    };
    let rows: Row[] | null = null;
    let loading: Promise<void> | null = null;
    let shown = 0;
    const PAGE = 30;

    const load = () => {
      loading ??= fetch('/data/operator-finder.json')
        .then((r) => r.json())
        .then((d) => {
          rows = d.operators as Row[];
          render(true);
        })
        .catch(() => {
          count.textContent = 'Could not load the operator list — please use the province lists below.';
        });
      return loading;
    };

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

    const matches = (): Row[] => {
      if (!rows) return [];
      const term = q.value.trim().toLowerCase();
      const p = prov.value;
      const active = chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.service!);
      return rows.filter((r) => {
        if (p && r.prov !== p) return false;
        if (active.length && !active.every((s) => r.sf.includes(s))) return false;
        if (term && !(`${r.n} ${r.b ?? ''}`.toLowerCase().includes(term))) return false;
        return true;
      });
    };

    const card = (r: Row) => `
      <li class="rounded-lg bg-birch-50 px-4 py-3 ring-1 ring-birch-200">
        <div class="flex items-start justify-between gap-2">
          <span class="font-semibold text-lake-900">${esc(r.n)}</span>
          ${r.f ? '<span class="rounded bg-ember-500 px-1.5 py-0.5 text-[11px] font-bold text-lake-950">Featured</span>' : ''}
        </div>
        ${r.b ? `<div class="mt-0.5 text-sm text-slate-600">${esc(r.b)}</div>` : ''}
        ${r.s ? `<div class="mt-0.5 text-xs text-slate-600">${esc(r.s)}${r.a ? ` · ${esc(r.a)}` : ''}</div>` : ''}
        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          ${r.p && r.t ? `<a href="tel:${esc(r.t)}" class="font-semibold text-lake-700 hover:underline">${esc(r.p)}</a>` : ''}
          <a href="${esc(r.d)}" class="text-lake-700 hover:underline">Directory page</a>
        </div>
      </li>`;

    const render = (reset: boolean) => {
      if (reset) shown = PAGE;
      const m = matches();
      count.textContent = rows
        ? `${m.length} operator${m.length === 1 ? '' : 's'} match${m.length === 1 ? 'es' : ''}`
        : 'Loading operators…';
      list.innerHTML = m.slice(0, shown).map(card).join('');
      more.classList.toggle('hidden', m.length <= shown);
    };

    q.addEventListener('focus', load, { once: true });
    q.addEventListener('input', () => (rows ? render(true) : load()));
    prov.addEventListener('change', () => (rows ? render(true) : load()));
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        const on = c.getAttribute('aria-pressed') === 'true';
        c.setAttribute('aria-pressed', String(!on));
        c.classList.toggle('bg-lake-700', !on);
        c.classList.toggle('text-white', !on);
        c.classList.toggle('border-lake-700', !on);
        rows ? render(true) : load();
      })
    );
    more.addEventListener('click', () => {
      shown += PAGE;
      render(false);
    });

    // Prefetch when the finder scrolls into view so first keystroke is instant.
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) {
        load();
        obs.disconnect();
      }
    }).observe(root);

    count.textContent = 'Start typing, or pick a province.';
    root.classList.remove('hidden');
  }
</script>
