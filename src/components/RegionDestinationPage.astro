---
/** Shared template for USA / Bahamas / Caribbean destination pages. */
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../lib/site';

interface Props {
  entry: CollectionEntry<'destinations'>;
  siblings: CollectionEntry<'destinations'>[];
  regionLabel: string;
  regionPath: string;
}

const { entry, siblings, regionLabel, regionPath } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const h1 = d.airportCode
  ? `${d.city} Charter Flights (${d.airportCode})`
  : `${d.city} Charter Flights`;

const nearby = siblings
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => (a.data.city ?? '').localeCompare(b.data.city ?? ''))
  .slice(0, 12);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Air Charter Flights',
    name: h1,
    provider: { '@id': `${SITE.url}/#org` },
    areaServed: { '@type': 'Place', name: `${d.city}, ${regionLabel}` },
    description: d.description,
    offers: { '@type': 'Offer', priceCurrency: 'CAD', url: `${SITE.url}/quote` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: regionLabel, item: `${SITE.url}${regionPath}` },
      { '@type': 'ListItem', position: 3, name: h1 },
    ],
  },
];
---

<BaseLayout title={d.title} description={d.description} canonicalPath={`/${d.slug}`} jsonLd={jsonLd}>
  <div class="bg-gradient-to-b from-lake-900 to-lake-800 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
      <Breadcrumbs crumbs={[{ label: regionLabel, href: regionPath }, { label: d.city ?? h1 }]} />
      <h1 class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-bold">{h1}</h1>
      <p class="mt-3 max-w-3xl text-lake-100 text-lg leading-relaxed">{d.description}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#quote" class="rounded-lg bg-ember-500 px-6 py-3 font-bold text-lake-950 hover:bg-ember-400 transition-colors">
          Get Free Quotes
        </a>
        <a href={SITE.phoneHref} class="rounded-lg border border-white/30 px-5 py-3 font-semibold hover:bg-white/10 transition-colors">
          {SITE.phone}
        </a>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
    <div class="grid gap-10 lg:grid-cols-3">
      <article class="lg:col-span-2 copy">
        <Content />
      </article>
      <aside class="space-y-6">
        <div class="rounded-2xl bg-white p-6 ring-1 ring-birch-200 shadow-sm">
          <h2 class="font-display text-lg font-bold text-lake-900">Up to 3 competitive quotes</h2>
          <ul class="mt-3 space-y-2 text-sm text-slate-600">
            <li>✓ Free, no obligation</li>
            <li>✓ Matched to operators equipped for your trip</li>
            <li>✓ Book direct with the airline</li>
          </ul>
          <a href="#quote" class="mt-4 block rounded-lg bg-ember-500 px-4 py-2.5 text-center font-bold text-lake-950 hover:bg-ember-400 transition-colors">
            Request Quotes
          </a>
        </div>
        {nearby.length > 0 && (
          <div class="rounded-2xl bg-white p-6 ring-1 ring-birch-200 shadow-sm">
            <h2 class="font-display text-lg font-bold text-lake-900">More {regionLabel} destinations</h2>
            <ul class="mt-3 grid gap-1.5 text-sm">
              {nearby.map((e) => (
                <li>
                  <a href={`/${e.data.slug}`} class="text-lake-600 hover:text-lake-800 hover:underline">
                    {e.data.city} charter flights
                  </a>
                </li>
              ))}
            </ul>
            <a href={regionPath} class="mt-3 inline-block text-sm font-semibold text-boreal-600 hover:text-boreal-700">
              All {regionLabel} destinations →
            </a>
          </div>
        )}
      </aside>
    </div>

    <section id="quote" class="mt-14 scroll-mt-24">
      <div class="rounded-2xl bg-white p-6 sm:p-10 ring-1 ring-birch-200 shadow-sm">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-lake-900">
          Receive up to 3 competitive quotes — {d.city}
        </h2>
        <div class="mt-8">
          <QuoteForm subject={d.quoteSubject ?? `Charter Flights ${d.city}`} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
