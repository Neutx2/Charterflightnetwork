---
/**
 * Charter Flight Network icon — one aircraft, three contrails.
 *
 * This is the companion mark to the logotype in Wordmark.astro, for the places
 * that need a square: favicon, social card, app icon, status board. The
 * logotype stays the classic arc-over-wordmark; this is the mark that has to
 * survive a browser tab.
 *
 * WHY IT LOOKS LIKE THIS — the reasoning, so it isn't relitigated:
 *
 * 1. The old icon failed the only test that matters for a favicon. Rendered at
 *    a true 16 device pixels it was an orange smudge with a speck: the swoosh
 *    was a 4.8/64 stroke and the aircraft about five pixels of detail. Standard
 *    scalability guidance is blunt about this — thin strokes vanish, and the
 *    test is to reduce the mark to a few pixels and see if it survives.
 *
 * 2. It could not be a C. A tapered C read beautifully at 16px and doubled as
 *    the initial of Charterflight — but Chartright Air Group, which CFN lists
 *    in its own directory, already uses a bold C mark on a dark square. A
 *    broker whose mark echoes one of its listed operators looks derivative at
 *    best and affiliated at worst.
 *
 * 3. It could not be a plain aircraft either. CFN's own legacy operator sheets
 *    (src/assets/legacy/CFN_Images/Air_Charter_650/air_charter_logos/) show the
 *    peer set is saturated with aircraft, wings, birds, feathers and sun discs
 *    — and the directory renders 530 of those logos beside this one. CFN is not
 *    an operator; it is the network above them, and needs to read that way.
 *
 * 4. So: an aircraft (which is what the business is about) trailed by three
 *    contrails (which is what only this business does — one request, up to
 *    three competitive quotes). The trails are white rather than orange for a
 *    purely practical reason: tested at 16px, orange-on-orange merges into the
 *    fuselage and the mark collapses back into a blob. The two-colour split is
 *    what keeps it legible.
 *
 * 5. The contrails lie on the aircraft's flight path, not across it. They were
 *    horizontal while the aircraft banked at 40 degrees, so the trails read as
 *    speed lines rather than as this aircraft's own wake. Each segment now runs
 *    at exactly the aircraft's heading — delta (7, -8.4), which is atan2(7, 8.4)
 *    = 40 degrees — directly behind it.
 *
 * Colours are sampled from the classic logo, not chosen:
 * src/assets/legacy/Logo_green_white.jpg — #ff7d02 on #1c5b6a.
 */
interface Props {
  /** rendered size in px */
  size?: number;
  /** tile colour; omit for the bare mark on an existing ground */
  tile?: string;
  class?: string;
}
const { size = 36, tile = '#1c5b6a', class: cls = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  class={cls}
  aria-hidden="true"
  focusable="false"
>
  {tile && <rect width="64" height="64" rx="15" fill={tile} />}
  <g stroke="#faf8f4" stroke-width="5.4" stroke-linecap="round" opacity=".85">
    <path d="M14.5 47L21.5 38.6" />
    <path d="M21.5 53L28.5 44.6" />
    <path d="M28.5 59L35.5 50.6" />
  </g>
  <g transform="translate(41 27) rotate(40) scale(1.02) translate(-32 -32)" fill="#ff7d02">
    <path
      d="M32 8c2.6 0 4.2 2.9 4.2 7.4v9.1l16.3 9.6c.9.5 1.5 1.5 1.5 2.6v4.1c0 .9-.9 1.6-1.8 1.3l-16-5.2v9.4l4.6 3.7c.5.4.8 1 .8 1.6v2.2c0 .8-.7 1.3-1.4 1.1L32 52.8l-8.2 1.1c-.7.2-1.4-.3-1.4-1.1v-2.2c0-.6.3-1.2.8-1.6l4.6-3.7v-9.4l-16 5.2c-.9.3-1.8-.4-1.8-1.3v-4.1c0-1.1.6-2.1 1.5-2.6l16.3-9.6v-9.1C27.8 10.9 29.4 8 32 8z"
    />
  </g>
</svg>
