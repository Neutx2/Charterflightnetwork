---
/**
 * Charter Flight Network mark — "the arc, kept".
 *
 * Descends from the legacy logo: the orange flight arc survives, redrawn as a
 * clean climbing path with the aircraft lifting off its leading tip.
 *
 * The aircraft is drawn from above (the "airplane-mode" silhouette) rather
 * than side-on. That matters: the previous side-on drawing was only ~9px of
 * thin detail at the 36px header size and collapsed into a speck. A top-down
 * plan form holds together down to 20px, which is the size that actually
 * ships — favicon, browser tab, phone bookmark.
 *
 * Single source of truth — header, favicon (public/favicon.svg) and the social
 * share image (scripts/build_og_image.mjs) all use these same paths.
 */
interface Props {
  /** rendered size in px */
  size?: number;
  /** tile colour — lighter on dark grounds so the mark doesn't disappear */
  tile?: string;
  class?: string;
}
const { size = 36, tile = '#1d486b', class: cls = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  class={cls}
  aria-hidden="true"
  focusable="false"
>
  <rect width="64" height="64" rx="15" fill={tile} />
  <path
    d="M10 50C22 50 34 42 42 26"
    stroke="#e8940f"
    stroke-width="5.4"
    stroke-linecap="round"
    fill="none"
  />
  <g transform="translate(43 21) rotate(45) scale(.55) translate(-32 -32)">
    <path
      fill="#faf8f4"
      d="M32 8c2.6 0 4.2 2.9 4.2 7.4v9.1l16.3 9.6c.9.5 1.5 1.5 1.5 2.6v4.1c0 .9-.9 1.6-1.8 1.3l-16-5.2v9.4l4.6 3.7c.5.4.8 1 .8 1.6v2.2c0 .8-.7 1.3-1.4 1.1L32 52.8l-8.2 1.1c-.7.2-1.4-.3-1.4-1.1v-2.2c0-.6.3-1.2.8-1.6l4.6-3.7v-9.4l-16 5.2c-.9.3-1.8-.4-1.8-1.3v-4.1c0-1.1.6-2.1 1.5-2.6l16.3-9.6v-9.1C27.8 10.9 29.4 8 32 8z"
    />
  </g>
</svg>
