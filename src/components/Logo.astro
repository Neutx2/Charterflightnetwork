---
/**
 * Charter Flight Network mark — "three routes, one answer".
 *
 * Three flight paths converge on a single point: one request reaches the
 * network, up to three competitive quotes come back to you. That is the whole
 * business model, so the mark says something only this company can say —
 * unlike an aircraft glyph, which every operator, broker and booking app on
 * earth already uses, and which the name "Charter Flight Network" says in
 * words anyway.
 *
 * Drawn as strokes rather than filled detail so it survives being 16px in a
 * browser tab. Two earlier attempts failed exactly there: a side-on aircraft
 * was ~9px of thin detail at header size and collapsed into a speck.
 *
 * Single source of truth — header, favicon (public/favicon.svg), the social
 * card (scripts/build_og_image.mjs) and the owner status board
 * (scripts/build_status_page.py) all reproduce these same paths.
 */
interface Props {
  /** rendered size in px */
  size?: number;
  /** tile colour — lighter on dark grounds so the mark doesn't disappear */
  tile?: string;
  class?: string;
}
const { size = 36, tile = '#1d486b', class: cls = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  class={cls}
  aria-hidden="true"
  focusable="false"
>
  <rect width="64" height="64" rx="15" fill={tile} />
  <g fill="none" stroke="#faf8f4" stroke-linecap="round" stroke-width="5">
    <path d="M11 13C29 13 36 20 45 31" />
    <path d="M11 32h34" />
    <path d="M11 51C29 51 36 44 45 33" />
  </g>
  <circle cx="47" cy="32" r="8" fill="#e8940f" />
</svg>
