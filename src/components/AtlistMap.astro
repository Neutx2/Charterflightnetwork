---
/**
 * Interactive Atlist map embed with mobile-friendly loading.
 *
 * The iframe is injected by IntersectionObserver as the reader approaches it,
 * so the map is live by the time it's on screen — no click-to-load barrier.
 * On touch devices a transparent shield keeps one-finger drags scrolling the
 * page; a single tap hands control to the map, and the shield re-arms once
 * the map scrolls out of view.
 */
interface Props {
  mapId: string;
  city: string;
  title?: string;
}
const { mapId, city, title = `Interactive map of charter flight departure points for ${city}` } = Astro.props;
const mapUrl = `https://my.atlist.com/map/${mapId}?share=true`;
---

<section id="map" class="scroll-mt-24">
  <div
    class="atlist-map relative overflow-hidden rounded-2xl bg-lake-50 ring-1 ring-birch-200 shadow-sm h-[clamp(340px,65vh,600px)] md:h-[560px]"
    data-map-url={mapUrl}
    data-map-title={title}
  >
    <div class="atlist-map-skeleton absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-lake-50 transition-opacity duration-500" aria-hidden="true">
      <svg class="h-10 w-10 animate-bounce text-lake-400" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
      </svg>
      <p class="text-sm font-semibold text-lake-600">Loading interactive map…</p>
    </div>

    <button
      type="button"
      class="atlist-map-shield absolute inset-0 z-20 hidden w-full cursor-pointer items-end justify-center bg-transparent pb-5 transition-opacity duration-300"
      aria-label={`Activate the interactive ${city} departure map`}
    >
      <span class="pointer-events-none inline-flex items-center gap-2 rounded-full bg-lake-900/85 px-4 py-2 text-sm font-semibold text-white shadow-lg backdrop-blur-sm">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 13V4.5a1.5 1.5 0 0 1 3 0V12m0-.5v-2a1.5 1.5 0 0 1 3 0V12m0-1.5a1.5 1.5 0 0 1 3 0V12" />
          <path d="M17 11.5a1.5 1.5 0 0 1 3 0V16a6 6 0 0 1-6 6h-2h.2a6 6 0 0 1-5-2.7L7 19c-.7-1-2.1-3.2-3.5-5.2a1.5 1.5 0 0 1 2.4-1.7L8 15" />
        </svg>
        Tap to explore the map
      </span>
    </button>

    <noscript>
      <div class="absolute inset-0 z-30 flex items-center justify-center bg-lake-50 p-6 text-center">
        <a href={mapUrl} class="font-semibold text-lake-600 underline hover:text-lake-800" rel="noopener">
          Open the interactive {city} departure map
        </a>
      </div>
    </noscript>
  </div>
</section>

<script>
  function initAtlistMap(wrap: HTMLElement) {
    let loaded = false;

    const load = () => {
      if (loaded) return;
      loaded = true;

      const iframe = document.createElement('iframe');
      iframe.src = wrap.dataset.mapUrl ?? '';
      iframe.title = wrap.dataset.mapTitle ?? 'Interactive map';
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      iframe.setAttribute('allow', 'fullscreen');
      iframe.setAttribute('loading', 'eager');
      iframe.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');

      iframe.addEventListener('load', () => {
        const skeleton = wrap.querySelector<HTMLElement>('.atlist-map-skeleton');
        if (skeleton) {
          skeleton.style.opacity = '0';
          setTimeout(() => skeleton.remove(), 500);
        }
        armShield();
      });

      wrap.insertBefore(iframe, wrap.firstChild);
    };

    // Touch devices: shield the iframe so one-finger drags keep scrolling the
    // page. A tap dismisses it; leaving the viewport re-arms it.
    const shield = wrap.querySelector<HTMLElement>('.atlist-map-shield');
    const isTouch = window.matchMedia('(pointer: coarse)').matches;

    const armShield = () => {
      if (!shield || !isTouch) return;
      shield.classList.remove('hidden');
      shield.classList.add('flex');
      shield.style.opacity = '1';
      shield.style.pointerEvents = 'auto';
    };

    shield?.addEventListener('click', () => {
      shield.style.opacity = '0';
      shield.style.pointerEvents = 'none';
    });

    if (!('IntersectionObserver' in window)) {
      load();
      return;
    }

    const loader = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          load();
          loader.disconnect();
        }
      },
      { rootMargin: '600px 0px' }
    );
    loader.observe(wrap);

    if (isTouch) {
      const rearm = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting && loaded) armShield();
        });
      });
      rearm.observe(wrap);
    }
  }

  document.querySelectorAll<HTMLElement>('.atlist-map').forEach(initAtlistMap);
</script>
