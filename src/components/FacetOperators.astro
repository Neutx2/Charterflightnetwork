---
/**
 * Operator cards for a service facet + provinces — the use-case-page
 * counterpart of LocalOperators (e.g. float plane operators in Ontario and
 * Manitoba on the fly-in fishing page). Fully static, no-JS-safe; phone
 * links inherit the delegated GA4 contact_phone event.
 */
import { operatorsByFacet, facetIconTypes } from '../lib/operator-data';
import AircraftIcon from './AircraftIcon.astro';

interface Props {
  heading: string;
  description: string;
  facet: 'Floats' | 'Wheels' | 'Helicopter' | 'Skis';
  provinces: string[];
  limit?: number;
}
const { heading, description, facet, provinces, limit = 6 } = Astro.props;
const { operators: ops, total } = operatorsByFacet(facet, provinces, limit);
const links = provinces.map((p) => ({
  label: p,
  href: `/directory/?prov=${encodeURIComponent(p)}&type=${encodeURIComponent(facet)}#find-an-operator`,
}));
---

{ops.length > 0 && (
  <section class="mt-10" aria-label={heading}>
    <h2 class="font-display text-2xl font-bold text-lake-900">{heading}</h2>
    <p class="mt-2 text-slate-600">{description}</p>
    <ul class="mt-5 grid list-none gap-3 p-0 sm:grid-cols-2">
      {ops.map((o) => (
        <li class="rounded-xl bg-white p-4 ring-1 ring-birch-200">
          <div class="flex items-start justify-between gap-2">
            <span class="font-semibold text-lake-900">{o.name}</span>
            {o.featured && (
              <span class="rounded bg-ember-500 px-1.5 py-0.5 text-[11px] font-bold text-lake-950">Featured</span>
            )}
          </div>
          {o.base && <div class="mt-0.5 text-sm text-slate-600">{o.base}</div>}
          {o.serviceType && (
            <div class="mt-1 flex items-center gap-2 text-xs text-slate-600">
              {facetIconTypes(o.serviceType).length > 0 && (
                <span class="flex shrink-0 gap-1.5 text-lake-400" aria-hidden="true">
                  {facetIconTypes(o.serviceType).map((t) => (
                    <AircraftIcon type={t} class="h-4 w-auto" />
                  ))}
                </span>
              )}
              <span>{o.serviceType}{o.aircraft ? ` · ${o.aircraft}` : ''}</span>
            </div>
          )}
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {o.phoneDisplay && o.phoneTel && (
              <a href={`tel:${o.phoneTel}`} class="font-semibold text-lake-700 hover:underline">{o.phoneDisplay}</a>
            )}
            <a href={o.directoryPage} class="text-lake-700 hover:underline">Directory page</a>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-slate-600">
      {total} matching operators in the directory — search them all:
      {links.map((l, i) => (
        <>
          <a href={l.href} class="font-semibold text-lake-700 hover:underline">{l.label}</a>{i < links.length - 1 ? ' · ' : ''}
        </>
      ))}
      <span> — or </span>
      <a href="#quote" class="font-semibold text-boreal-700 hover:underline">get up to 3 competitive quotes</a>
      <span> with one request.</span>
    </p>
  </section>
)}
