---
/**
 * Charter quote request form.
 *
 * Preserves the legacy conversion funnel exactly:
 *   POST /formmailer.php  (PHP FormMail script on the existing shared host)
 *   hidden: recipient, redirect, subject  ·  honeypot: "website"
 *   field names match the legacy form so formmailer.php keeps working as-is.
 *
 * TODO(deploy): If deploying to Netlify instead of the existing shared host,
 * formmailer.php will not exist. Switch by (1) adding `data-netlify="true"`
 * and `name="charter-quote"` to <form>, (2) changing action to "/quote-confirmation",
 * (3) adding <input type="hidden" name="form-name" value="charter-quote">.
 * The static fallback form for Netlify build-bots is in public/netlify-forms.html.
 */
import { SITE } from '../lib/site';

interface Props {
  /** Email subject line forwarded by formmailer.php, e.g. "Charter Flights Thunder Bay ON" */
  subject?: string;
  compact?: boolean;
}

const { subject = 'Charter Quote Request', compact = false } = Astro.props;

const aircraft = [
  { name: 'Jet', label: 'Jet' },
  { name: 'Turboprop', label: 'Turboprop' },
  { name: 'Piston', label: 'Piston Aircraft' },
  { name: 'Wheels', label: 'Wheel Plane' },
  { name: 'Floats', label: 'Float Plane' },
  { name: 'Helicopter', label: 'Helicopter' },
];

const inputCls =
  'w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-slate-900 placeholder-slate-400 shadow-sm focus:border-lake-500 focus:outline-none focus:ring-2 focus:ring-lake-500/30';
const labelCls = 'block text-sm font-semibold text-slate-700 mb-1.5';
---

<form
  method="post"
  action="/formmailer.php"
  class="quote-form"
  novalidate
  aria-label="Charter quote request"
>
  <!-- honeypot (legacy anti-spam, keep name="website") -->
  <div class="absolute -left-[5000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
    <label for={`website-${subject.length}`}>Website</label>
    <input type="text" id={`website-${subject.length}`} name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class:list={['grid gap-4', compact ? 'sm:grid-cols-2' : 'sm:grid-cols-2']}>
    <div>
      <label class={labelCls} for={`FlyFrom-${subject.length}`}>Fly from <span class="text-red-600">*</span></label>
      <input class={inputCls} type="text" id={`FlyFrom-${subject.length}`} name="FlyFrom" placeholder="Departure city or airport" required autocomplete="off" />
    </div>
    <div>
      <label class={labelCls} for={`FlyTo-${subject.length}`}>Fly to <span class="text-red-600">*</span></label>
      <input class={inputCls} type="text" id={`FlyTo-${subject.length}`} name="FlyTo" placeholder="Destination city or airport" required autocomplete="off" />
    </div>

    <fieldset class="sm:col-span-2">
      <legend class="text-sm font-semibold text-slate-700 mb-1.5">Trip type</legend>
      <div class="flex gap-4">
        <label class="inline-flex items-center gap-2 text-sm text-slate-700">
          <input type="radio" name="TripType" value="Return" checked class="h-4 w-4 accent-lake-600" data-trip-type />
          Return
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-slate-700">
          <input type="radio" name="TripType" value="One-way" class="h-4 w-4 accent-lake-600" data-trip-type />
          One-way
        </label>
      </div>
    </fieldset>

    <div>
      <label class={labelCls} for={`DepartDate-${subject.length}`}>Departure date</label>
      <input class={inputCls} type="date" id={`DepartDate-${subject.length}`} name="DepartDate" />
    </div>
    <div data-return-date-wrap>
      <label class={labelCls} for={`ReturnDate-${subject.length}`}>Return date</label>
      <input class={inputCls} type="date" id={`ReturnDate-${subject.length}`} name="ReturnDate" />
    </div>

    <div>
      <label class={labelCls} for={`Passengers-${subject.length}`}>Passengers <span class="text-red-600">*</span></label>
      <input class={inputCls} type="number" min="1" inputmode="numeric" id={`Passengers-${subject.length}`} name="Passengers" required />
    </div>

    <fieldset class="sm:col-span-2">
      <legend class="text-sm font-semibold text-slate-700 mb-1.5">Aircraft preference <span class="font-normal text-slate-600">— select one or more</span></legend>
      <div class="grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3">
        {aircraft.map((a) => (
          <label class="inline-flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" name={a.name} value={a.name} class="h-4 w-4 rounded accent-lake-600" />
            {a.label}
          </label>
        ))}
      </div>
    </fieldset>

    <div>
      <label class={labelCls} for={`Name-${subject.length}`}>Name <span class="text-red-600">*</span></label>
      <input class={inputCls} type="text" id={`Name-${subject.length}`} name="Name" autocomplete="name" required />
    </div>
    <div>
      <label class={labelCls} for={`Email-${subject.length}`}>Email <span class="text-red-600">*</span></label>
      <input class={inputCls} type="email" id={`Email-${subject.length}`} name="Email" autocomplete="email" required />
    </div>
    <div>
      <label class={labelCls} for={`Phone-${subject.length}`}>Phone</label>
      <input class={inputCls} type="tel" id={`Phone-${subject.length}`} name="Phone" autocomplete="tel" />
    </div>
    <div>
      <label class={labelCls} for={`City-${subject.length}`}>Your city / province</label>
      <input class={inputCls} type="text" id={`City-${subject.length}`} name="City" autocomplete="address-level2" />
    </div>

    <div class="sm:col-span-2">
      <label class={labelCls} for={`OtherInfo-${subject.length}`}>Comments or alternate departure city</label>
      <textarea class={inputCls} id={`OtherInfo-${subject.length}`} name="OtherInfo" rows="4"></textarea>
    </div>
  </div>

  <p class="mt-4 text-xs text-slate-600">
    <strong>Privacy:</strong> we don’t share your name or contact info with airlines.
    Your request is assigned a unique ID; airlines submit quotes for that ID and we
    forward them to you.
  </p>

  <div class="mt-5 flex flex-col items-center gap-3 sm:flex-row">
    <button
      type="submit"
      class="w-full sm:w-auto rounded-lg bg-ember-500 px-8 py-3.5 text-base font-bold text-lake-950 shadow-md hover:bg-ember-400 transition-colors"
    >
      Request Competitive Quotes
    </button>
    <span class="text-sm text-slate-600">or call <a href={SITE.phoneHref} class="font-semibold text-lake-700 hover:underline">{SITE.phone}</a></span>
  </div>

  <p class="quote-form-error mt-3 hidden rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-800" role="alert"></p>

  <input type="hidden" name="recipient" value="phil@charterflightnetwork.com" />
  <input type="hidden" name="redirect" value="https://charterflightnetwork.com/quote-confirmation" />
  <input type="hidden" name="subject" value={subject} />
</form>

<script>
  // Client-side validation + one-way/return toggle for every quote form on the page.
  document.querySelectorAll<HTMLFormElement>('form.quote-form').forEach((form) => {
    const returnWrap = form.querySelector<HTMLElement>('[data-return-date-wrap]');
    const returnInput = returnWrap?.querySelector<HTMLInputElement>('input');
    form.querySelectorAll<HTMLInputElement>('[data-trip-type]').forEach((radio) => {
      radio.addEventListener('change', () => {
        const oneWay = radio.value === 'One-way' && radio.checked;
        if (returnWrap) returnWrap.classList.toggle('hidden', oneWay);
        if (oneWay && returnInput) returnInput.value = '';
      });
    });

    const errorBox = form.querySelector<HTMLElement>('.quote-form-error');
    form.addEventListener('submit', (e) => {
      const missing: string[] = [];
      form.querySelectorAll<HTMLInputElement>('input[required]').forEach((input) => {
        input.classList.remove('border-red-500');
        if (!input.value.trim() || (input.type === 'email' && !input.checkValidity())) {
          missing.push(input.closest('div')?.querySelector('label')?.textContent?.replace('*', '').trim() ?? input.name);
          input.classList.add('border-red-500');
        }
      });
      if (missing.length) {
        e.preventDefault();
        if (errorBox) {
          errorBox.textContent = `Please complete: ${missing.join(', ')}.`;
          errorBox.classList.remove('hidden');
          errorBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
      }
    });
  });
</script>
