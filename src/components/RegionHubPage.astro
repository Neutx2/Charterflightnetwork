---
/** Shared hub template for USA / Bahamas / Caribbean directory pages. */
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteForm from '../components/QuoteForm.astro';

interface Props {
  hub?: CollectionEntry<'hubs'>;
  destinations: CollectionEntry<'destinations'>[];
  regionLabel: string;
  regionPath: string;
  title: string;
  description: string;
  h1: string;
}

const { hub, destinations, regionLabel, regionPath, title, description, h1 } = Astro.props;
const sorted = [...destinations].sort((a, b) =>
  (a.data.city ?? '').localeCompare(b.data.city ?? '')
);
const Content = hub ? (await render(hub)).Content : null;

const SITE_URL = 'https://charterflightnetwork.com';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Air Charter Flights',
    name: h1,
    provider: { '@id': `${SITE_URL}/#org` },
    areaServed: { '@type': 'Place', name: regionLabel },
    description,
    offers: { '@type': 'Offer', priceCurrency: 'CAD', url: `${SITE_URL}/quote` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: regionLabel },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={regionPath} jsonLd={jsonLd}>
  <div class="bg-gradient-to-b from-lake-900 to-lake-800 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
      <Breadcrumbs crumbs={[{ label: regionLabel }]} />
      <h1 class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-bold">{h1}</h1>
      <p class="mt-3 max-w-3xl text-lake-100 text-lg leading-relaxed">{description}</p>
      <div class="mt-6">
        <a href="#quote" class="rounded-lg bg-ember-500 px-6 py-3 font-bold text-lake-950 hover:bg-ember-400 transition-colors">
          Get Free Quotes
        </a>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
    {sorted.length > 0 && (
      <section class="mb-12">
        <h2 class="font-display text-2xl font-bold text-lake-900">
          {regionLabel} charter flight destinations
        </h2>
        <ul class="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {sorted.map((e) => (
            <li>
              <a
                href={`/${e.data.slug}`}
                class="block rounded-lg bg-white px-4 py-2.5 text-sm font-medium text-lake-700 ring-1 ring-birch-200 hover:ring-lake-300 hover:text-lake-900 hover:shadow-sm transition"
              >
                {e.data.city}
                {e.data.airportCode && <span class="text-slate-400"> ({e.data.airportCode})</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {Content && (
      <article class="copy max-w-4xl">
        <Content />
      </article>
    )}

    <section id="quote" class="mt-14 scroll-mt-24">
      <div class="rounded-2xl bg-white p-6 sm:p-10 ring-1 ring-birch-200 shadow-sm">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-lake-900">
          Receive up to 3 competitive quotes — {regionLabel}
        </h2>
        <div class="mt-8">
          <QuoteForm subject={hub?.data.quoteSubject ?? `Charter Flights ${regionLabel}`} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
